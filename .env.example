# Supabase
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# AI Provider (gemini | openai | claude | openrouter)
VITE_AI_PROVIDER=gemini

# Required for AI Mentor, GitHub Evaluator, etc.
# Get your key: https://aistudio.google.com/apikey
# Setup guide: docs/gemini-setup.md
VITE_GEMINI_API_KEY=your-gemini-api-key

# Optional Gemini tuning (see docs/gemini-setup.md)
# VITE_GEMINI_MODEL=gemini-2.5-flash
# VITE_GEMINI_MAX_RETRIES=3
# VITE_GEMINI_CLIENT_RPM=10

# Future providers
# VITE_OPENAI_API_KEY=your-openai-api-key
# VITE_ANTHROPIC_API_KEY=your-anthropic-api-key
# VITE_OPENROUTER_API_KEY=your-openrouter-api-key

# Optional — increases GitHub API rate limit (5000/hr vs 60/hr)
# VITE_GITHUB_TOKEN=your-github-personal-access-token

# App
VITE_APP_URL=http://localhost:5173
